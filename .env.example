# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# --- Sign-in (temporary, until CW University / Google sign-in is connected) ---
# Long random string used to sign session cookies.
SESSION_SECRET=
# Each person's own access code, as JSON: {"miguel":"ClubWealth-MiguelAbabon-2026-XXXX", ...}.
# Keys are the person ids in src/config/people.ts. When set, only these codes work.
HUB_ACCESS_CODES=
# Old shared code, used only while HUB_ACCESS_CODES is not set.
HUB_ACCESS_CODE=

# --- Keap ---
# Keap Service Account Key or Personal Access Token (Keap → Settings → API).
# The hub is view-only for Keap: it only reads, never creates, changes, deletes or sends anything.
KEAP_API_KEY=

# --- Eventbrite (view-only) ---
# Private token: eventbrite.com → Account settings → Developer links → API keys → Private token.
EVENTBRITE_TOKEN=
# Optional: organization id (defaults to the token's first organization).
EVENTBRITE_ORG_ID=

# --- Zapier ---
# Secret that Zaps put in the inbox URL when they send updates to the hub:
# https://cw-ai-task-hub.vercel.app/api/zapier/inbox?key=<this>. Any long random text.
ZAPIER_INBOUND_SECRET=
# Optional: JSON map of Zap names to their "Catch Hook" URLs, e.g.
# {"half-day-part-1":"https://hooks.zapier.com/hooks/catch/123/abc/"}
ZAPIER_HOOKS=

# --- CW Assistant chat (/assistant) ---
# API token of the claude.ai routine "CW Assistant → Task Hub chat replies" (claude.ai/code → Routines).
# The chat also needs the storage below, so replies reach every server instance.
CLAUDE_CHAT_ROUTINE_TOKEN=
# Optional: a different routine id.
CHAT_ROUTINE_ID=
# Messages per team member per day (super admins have no limit). Default 20; resets at midnight Pacific.
CHAT_DAILY_LIMIT=20

# --- Spreadsheets people list in their workspace ---
# The Google account sheets must live in (other accounts need a super admin's approval in the hub).
SHEETS_ACCOUNT=marketingclubwealth@gmail.com

# --- Google Sheets (read-only) ---
# A Google Cloud service account key (the downloaded JSON, pasted as-is or base64-encoded).
# Each sheet is shared with the service account's email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Storage for integrations you add in the app, the run log and assistant chats ---
# Upstash Redis (Vercel → Storage → Upstash for Redis). Without it, data lives in memory and resets.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Workflow Process Form responses (read-only) ---
# The "AI Task Hub - Form Responses" sheet and its Submissions tab. It must be viewable by link.
FORM_RESPONSES_SHEET_ID=1St2MXhY7lugGYl4MdOXyJaTHkW9r1gohXx5uSkNSf4Y
FORM_RESPONSES_GID=106173124

# --- Embedding inside CW University ---
# Space-separated origins allowed to show the hub in an iframe.
FRAME_ANCESTORS=https://learning.clubwealth.com https://*.clubwealth.com

# --- Canva (Jay's Marketing Graphics task; Andrea's and Liz's Events tasks) ---
# A Canva integration made in the Canva Developer Portal (canva.dev → Your integrations), with the REST APIs on,
# scopes asset:read asset:write design:content:read design:content:write design:meta:read profile:read,
# and redirect URL https://cw-ai-task-hub.vercel.app/api/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional: hub people allowed to connect Canva (default: jaymar,andrea,liz)
CANVA_USERS=

# --- CW Hub Council (daily AI review, super admins) ---
# API token of the "CW Hub Council" routine (claude.ai → Routines → the routine → API token).
CLAUDE_COUNCIL_ROUTINE_TOKEN=
# Any long random text; Vercel's daily cron sends it so only the schedule can start a run.
CRON_SECRET=
