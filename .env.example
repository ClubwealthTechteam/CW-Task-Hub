# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# --- Sign-in (temporary, until CW University / Google sign-in is connected) ---
# Long random string used to sign session cookies.
SESSION_SECRET=
# Shared access code people type when they pick their name on /login.
HUB_ACCESS_CODE=

# --- Keap ---
# Keap Service Account Key or Personal Access Token (Keap → Settings → API).
KEAP_API_KEY=

# --- Buildium (Amrissa: properties, contractors, maintenance) ---
# Buildium → Settings → Developer tools → API keys (client ID + secret).
BUILDIUM_CLIENT_ID=
BUILDIUM_CLIENT_SECRET=
# Optional: sandbox base URL while testing, e.g. https://apisandbox.buildium.com
BUILDIUM_BASE_URL=

# --- Zapier ---
# Optional: JSON map of Zap names to their "Catch Hook" URLs, e.g.
# {"half-day-part-1":"https://hooks.zapier.com/hooks/catch/123/abc/"}
ZAPIER_HOOKS=

# --- CW Assistant chat (/assistant) ---
# API token of the claude.ai routine "CW Assistant → Task Hub chat replies" (claude.ai/code → Routines).
# The chat also needs the storage below, so replies reach every server instance.
CLAUDE_CHAT_ROUTINE_TOKEN=
# Optional: a different routine id.
CHAT_ROUTINE_ID=

# --- Storage for integrations you add in the app, the run log and assistant chats ---
# Upstash Redis (Vercel → Storage → Upstash for Redis). Without it, data lives in memory and resets.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Embedding inside CW University ---
# Space-separated origins allowed to show the hub in an iframe.
FRAME_ANCESTORS=https://learning.clubwealth.com https://*.clubwealth.com
